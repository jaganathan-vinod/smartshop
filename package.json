{
  "name": "smartshop",
  "private": true,
  "version": "0.1.0",
  "description": "SmartShop e-commerce MVP",
  "workspaces": [
    "infra",
    "packages/shared",
    "services/api"
  ],
  "scripts": {
    "build": "npm run build -w @smartshop/shared",
    "synth": "npm run synth -w infra",
    "diff": "npm run diff -w infra",
    "deploy": "npm run deploy -w infra",
    "seed": "tsx scripts/seed.ts",
    "verify:phase0": "bash scripts/verify-phase-0.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
